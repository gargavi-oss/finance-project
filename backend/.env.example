# DocForensic AI environment example. Copy to `.env` and edit as needed.

# --- LLM -----------------------------------------------------------------
# Gemini is the primary provider. Leave GEMINI_API_KEY empty to run in DEMO
# mode (deterministic mock LLM). Set a real key to use Gemini for synthesis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional fallbacks (only used if GEMINI_API_KEY is empty).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- App -----------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Data ----------------------------------------------------------------
DATA_DIR=./data
POLICY_PATH=./data/policy/acme_expense_policy.md
DB_URL=sqlite+aiosqlite:///./data/docforensic.db

# --- Forensics thresholds (0-1) ------------------------------------------
ELA_TAMPER_THRESHOLD=0.18      # proportion of pixels with high ELA delta
META_ANOMALY_THRESHOLD=0.50    # weighted score of suspicious metadata signals
FONT_INCONSISTENCY_THRESHOLD=0.35
RING_HAMMING_THRESHOLD=8       # pHash hamming distance <= this is a "ring hit"

# --- Verdict weights (must sum to 1.0) -----------------------------------
WEIGHT_FORENSICS=0.40
WEIGHT_POLICY=0.20
WEIGHT_HISTORY=0.15
WEIGHT_RING=0.25